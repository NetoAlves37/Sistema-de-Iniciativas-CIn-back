    "/sistema-de-iniciativas-cin/api/v1/iniciativas": {
      "post": {
        "operationId": "IniciativasController_submeter_v1",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DadosIniciativaDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Iniciativa criada em Em andamento (detalhe)"
          },
          "422": {
            "description": "Campos inválidos (RN-01 e RN-02), com `errors` por campo"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Submeter uma iniciativa (abre o refinamento)",
        "tags": [
          "Iniciativas"
        ]
      },
      "get": {
        "description": "Ex.: `status=EM_VOTACAO&ordenar=relevancia` (início) e `status=EM_ANDAMENTO&ordenar=prazo`.",
        "operationId": "IniciativasController_listar_v1",
        "parameters": [
          {
            "name": "page",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "exclusiveMinimum": false,
              "default": 1,
              "type": "integer"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 500,
              "exclusiveMaximum": false,
              "exclusiveMinimum": false,
              "default": 20,
              "type": "integer"
            }
          },
          {
            "name": "status",
            "required": false,
            "in": "query",
            "description": "Filtro por status",
            "schema": {
              "type": "string",
              "enum": [
                "EM_ANDAMENTO",
                "EM_VOTACAO",
                "EM_ANALISE",
                "APROVADA",
                "REPROVADA"
              ]
            }
          },
          {
            "name": "tipo",
            "required": false,
            "in": "query",
            "description": "Filtro por tipo",
            "schema": {
              "type": "string",
              "enum": [
                "EXTENSAO",
                "PESQUISA",
                "EVENTO"
              ]
            }
          },
          {
            "name": "q",
            "required": false,
            "in": "query",
            "description": "Busca em título, resumo, organizadores e espaço",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ordenar",
            "required": false,
            "in": "query",
            "description": "Ordenação (padrão: recentes)",
            "schema": {
              "type": "string",
              "enum": [
                "relevancia",
                "prazo",
                "recentes",
                "inicio"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Página de resumos de iniciativas"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Listar iniciativas (filtros, ordenação e paginação no servidor)",
        "tags": [
          "Iniciativas"
        ]
      }
    },
