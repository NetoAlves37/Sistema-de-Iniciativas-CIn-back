          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegistrarDecisaoDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Detalhe da iniciativa atualizado"
          },
          "401": {
            "description": "Token ausente ou inválido"
          },
          "403": {
            "description": "Sem perfil de comitê, ou o usuário é o autor da iniciativa"
          },
          "404": {
            "description": "Iniciativa não encontrada"
          },
          "409": {
            "description": "A iniciativa não está em análise ou já foi decidida"
          },
          "422": {
            "description": "Resultado inválido ou justificativa ausente"
          }
        },
        "security": [
