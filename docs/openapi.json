          },
          "nome": {
            "description": "Nome para exibição",
            "type": "string"
          },
          "perfil": {
            "description": "Perfil de exibição: ALUNO, PROFESSOR, COMITE ou ADMIN",
            "type": "string",
            "enum": [
              "ALUNO",
              "PROFESSOR",
              "COMITE",
              "ADMIN"
            ]
          },
          "ehComite": {
            "description": "Pode ver a fila de análise e decidir (membro do comitê ou administrador)",
            "type": "boolean"
          },
          "prazos": {
            "description": "Prazos configurados, usados nos textos da tela",
            "type": "object",
            "properties": {
              "refinamentoDias": {
                "description": "Dias de refinamento (sugestões)",
                "type": "number"
              },
              "votacaoDias": {
                "description": "Dias de votação",
                "type": "number"
              }
            },
            "required": [
              "refinamentoDias",
              "votacaoDias"
            ]
          }
        },
        "required": [
          "id",
          "nome",
          "perfil",
          "ehComite",
          "prazos"
        ]
      },
      "DadosIniciativaDto": {
        "type": "object",
        "properties": {
          "tipo": {
            "description": "Tipo: EXTENSAO, PESQUISA, EVENTO",
            "type": "string"
          },
          "titulo": {
            "description": "Título (até 120 caracteres)",
            "type": "string"
          },
          "resumo": {
            "description": "Descrição resumida (até 280 caracteres)",
            "type": "string"
          },
          "detalhe": {
            "description": "Descrição detalhada (até 5000 caracteres)",
            "type": "string"
          },
          "inicio": {
            "description": "Data de início (YYYY-MM-DD)",
            "type": "string"
          },
          "fim": {
            "description": "Data de término (YYYY-MM-DD), igual ou posterior ao início",
            "type": "string"
          },
          "horaInicio": {
            "description": "Hora de início (HH:mm), junto com horaFim",
            "type": "string",
            "nullable": true
          },
          "horaFim": {
            "description": "Hora de término (HH:mm), posterior ao início",
            "type": "string",
            "nullable": true
          },
          "periodicidade": {
            "description": "Periodicidade: EVENTO_UNICO, DIARIA, SEMANAL, QUINZENAL, MENSAL",
            "type": "string"
          },
          "espaco": {
            "description": "Espaço utilizado (até 200 caracteres)",
            "type": "string"
          },
          "organizadores": {
            "description": "Organizadores, separados por vírgula (até 500)",
            "type": "string"
          },
          "membros": {
            "description": "Membros (opcional, até 500)",
            "type": "string",
            "nullable": true
          },
          "participantes": {
            "description": "Quantidade de participantes (1 a 100000)",
            "type": "number"
          },
          "comVotacao": {
            "description": "Enviar para votação geral (padrão: true)",
            "type": "boolean"
          }
        }
      },
