          }
        },
        "required": [
          "texto"
        ]
      },
      "ComentarioResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "ciclo": {
            "description": "Ciclo da iniciativa em que o comentário foi feito",
