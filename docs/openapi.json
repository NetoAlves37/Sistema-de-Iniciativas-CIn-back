          },
          "autor": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "nome": {
                "type": "string"
              },
              "perfil": {
                "type": "string",
                "enum": [
                  "ALUNO",
                  "PROFESSOR",
                  "COMITE",
                  "ADMIN"
                ]
              },
              "ehAutorDaIniciativa": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "nome",
              "perfil",
              "ehAutorDaIniciativa"
            ]
          },
          "texto": {
            "type": "string"
          },
          "criadoEm": {
            "description": "Data e hora em ISO 8601",
            "type": "string"
          }
        },
        "required": [
          "id",
          "ciclo",
          "autor",
          "texto",
          "criadoEm"
        ]
      },
      "RegistrarVotoDto": {
        "type": "object",
        "properties": {
          "valor": {
            "description": "1 (curtir) ou -1 (não curtir)",
            "oneOf": [
              {
                "type": "number",
                "minimum": 1,
                "maximum": 1
              },
              {
                "type": "number",
                "minimum": -1,
                "maximum": -1
              }
            ]
          }
        },
        "required": [
          "valor"
        ]
      },
      "ResultadoVotoResponseDto": {
        "type": "object",
        "properties": {
          "meuVoto": {
            "description": "Voto atual; 0 = sem voto",
            "oneOf": [
              {
                "type": "number",
                "minimum": 1,
                "maximum": 1
              },
              {
                "type": "number",
                "minimum": -1,
                "maximum": -1
              },
              {
                "type": "number",
                "minimum": 0,
                "maximum": 0
              }
            ]
          },
          "likes": {
            "type": "integer"
          },
          "dislikes": {
            "type": "integer"
          },
          "relevancia": {
            "description": "Limite inferior de Wilson (0 a 1) do ciclo atual",
            "type": "number"
          },
          "acao": {
            "type": "string",
            "enum": [
              "REGISTRADO",
              "ALTERADO",
              "RETIRADO"
