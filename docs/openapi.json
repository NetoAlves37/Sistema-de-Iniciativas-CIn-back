        "type": "http"
      },
      "oauth2": {
        "type": "oauth2",
        "flows": {
          "password": {
            "tokenUrl": "http://localhost:8080/auth/realms/Local/protocol/openid-connect/token",
            "authorizationUrl": "http://localhost:8080/auth/realms/Local/protocol/openid-connect/auth",
            "scopes": {}
          }
        }
      }
    },
    "schemas": {
      "MeResponseDto": {
