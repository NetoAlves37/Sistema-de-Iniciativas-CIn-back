                      "enum": [
                        "ALUNO",
                        "PROFESSOR",
                        "COMITE",
                        "ADMIN"
                      ]
                    },
                    "ehAutorDaIniciativa": {
                      "type": "boolean"
                    }
                  },
                  "required": [
