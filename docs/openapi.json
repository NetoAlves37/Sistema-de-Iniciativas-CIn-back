    "/sistema-de-iniciativas-cin/api/v1/divulgacao/ocorrencias": {
      "get": {
        "description": "Intervalo `[de, ate)` de no máximo 62 dias. `inicio` e `fim` são `YYYY-MM-DD` (dia inteiro; `fim` exclusivo no Evento único) ou `YYYY-MM-DDTHH:mm`.",
        "operationId": "DivulgacaoController_ocorrencias_v1",
        "parameters": [
          {
            "name": "de",
            "required": true,
            "in": "query",
            "description": "Início, inclusivo",
            "schema": {
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "type": "string"
            }
          },
          {
            "name": "ate",
            "required": true,
            "in": "query",
            "description": "Fim, exclusivo (no máximo 62 dias depois de `de`)",
            "schema": {
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "type": "string"
            }
          },
          {
            "name": "tipos",
            "required": true,
            "in": "query",
            "description": "Lista separada por vírgulas de EXTENSAO, PESQUISA e EVENTO",
            "schema": {}
          },
          {
            "name": "minhas",
            "required": true,
            "in": "query",
            "description": "Só as iniciativas do usuário logado",
            "schema": {
              "default": "false",
              "type": "string",
              "enum": [
                "true",
                "false"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de ocorrências em ordem cronológica"
          },
          "401": {
            "description": "Token ausente ou inválido"
          },
          "403": {
            "description": "Sem permissão de acesso"
          },
          "422": {
            "description": "Datas inválidas ou intervalo maior que 62 dias"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Ocorrências das aprovadas no calendário",
        "tags": [
          "Divulgação"
        ]
      }
    },
