            "enum": [
              "APROVADA",
              "REPROVADA"
            ]
          },
          "justificativa": {
            "description": "Obrigatória na reprovação (1 a 2000 caracteres); ignorada na aprovação",
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "resultado"
        ]
      }
    }
