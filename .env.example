# Server
PORT=3000
NODE_ENV=development
API_PREFIX=sistema-de-iniciativas-cin/api

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=BD-SICIN

# Usada diretamente pelo Prisma CLI (migrations/generate); a aplicação também aceita
# só as variáveis DB_* acima e monta essa URL em runtime (ver src/config/database.config.ts).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/BD-SICIN

# Swagger
SWAGGER_TITLE=Sistema de Iniciativas - CIn API
SWAGGER_DESCRIPTION=API documentation for sistema-de-iniciativas-cin
SWAGGER_VERSION=1.0.0
SWAGGER_PATH=api/docs

# Keycloak (obrigatório: a API falha no boot se KEYCLOAK_AUTH_SERVER_URL ou KEYCLOAK_REALM faltarem)
# Valores abaixo já batem com o realm gerado em setup/realm.json e importado
# pelo serviço `keycloak` do docker-compose.yml.
KEYCLOAK_AUTH_SERVER_URL=http://localhost:8080/auth
KEYCLOAK_REALM=Local
KEYCLOAK_CLIENT_ID=sistema-de-iniciativas-cin-back
KEYCLOAK_JWKS_CACHE_MAX_AGE=600000
KEYCLOAK_JWKS_TIMEOUT=5000

# CORS: origens permitidas, separadas por vírgula. Obrigatório em produção.
CORS_ORIGINS=http://localhost:5173

# Prazos do ciclo de vida da iniciativa, em dias (aceita fração: 0.5 = 12 horas).
PRAZO_REFINAMENTO_DIAS=3
PRAZO_VOTACAO_DIAS=3

# Job de transições por prazo (cron de 5 ou 6 campos; padrão: a cada minuto) e fuso de negócio.
# Para ver as transições rápido em testes manuais: PRAZO_*_DIAS=0.0035 (~5 min).
TRANSICOES_CRON=*/1 * * * *
APP_TIMEZONE=America/Recife

# Modo de autenticação. `keycloak` (padrão) valida o JWT do Keycloak. `test` só existe com
# NODE_ENV=test (testes automatizados) e valida JWT HS256 assinado com TEST_JWT_SECRET.
AUTH_MODE=keycloak
# TEST_JWT_SECRET=
